# ───────────────────────────────────────────────────────────────────────────
# GLM Usage Monitor - environment template
# Copy this file to `.env` (next to docker-compose.yml) and fill in real values.
# All variables use the GLM_MONITOR_ prefix (see backend/app/config.py).
# ───────────────────────────────────────────────────────────────────────────

# Z.ai account credentials (required for the official quota poller to work).
GLM_MONITOR_ZAI_API_KEY=your_real_zai_api_key_here
GLM_MONITOR_ZAI_BASE_URL=https://api.z.ai
GLM_MONITOR_ZAI_MONITOR_ENDPOINT=/api/monitor/usage/quota/limit

# Z.ai admin usage poller: per-model hourly token usage from the monitor API.
# Uses the same key above and sees Coding Plan subscription traffic too.
GLM_MONITOR_ZAI_ADMIN_ENABLED=true
GLM_MONITOR_ZAI_ADMIN_POLL_INTERVAL_SECONDS=300

# Identity used by the "My Usage" / "Me vs Total" views. Set this to the
# user_id string your tools report when posting webhooks. Leave blank to
# disable per-user attribution.
GLM_MONITOR_USER_IDENTITY=you@example.com

# How often the scheduler polls the Z.ai quota endpoint (seconds).
GLM_MONITOR_POLL_INTERVAL_SECONDS=60

# SQLite database location (relative to backend/).
GLM_MONITOR_DATABASE_URL=sqlite+aiosqlite:///./data/glm_monitor.db

# Collectors
GLM_MONITOR_WEBHOOK_ENABLED=true
# Optional shared secret; clients send it via X-Webhook-Secret header.
GLM_MONITOR_WEBHOOK_SECRET=
GLM_MONITOR_PROXY_ENABLED=false
GLM_MONITOR_PROXY_PORT=8080
GLM_MONITOR_PROXY_TARGET_URL=https://api.z.ai
GLM_MONITOR_LOG_COLLECTOR_ENABLED=false

# ── Multi-provider admin usage pollers ───────────────────────────────────────
# Both are disabled unless an admin API key is set. They poll each provider's
# admin usage API (grouped by model, hourly buckets) and upsert aggregates into
# enriched_request with a `provider` tag (openai / anthropic).
#
# OpenAI (GPT / ChatGPT): needs an Admin API key, prefix sk-admin-...
GLM_MONITOR_OPENAI_ENABLED=false
GLM_MONITOR_OPENAI_API_KEY=
GLM_MONITOR_OPENAI_BASE_URL=https://api.openai.com
GLM_MONITOR_OPENAI_POLL_INTERVAL_SECONDS=300
#
# Anthropic (Claude / Claude Code): needs an Admin API key, prefix sk-ant-admin01-...
GLM_MONITOR_ANTHROPIC_ENABLED=false
GLM_MONITOR_ANTHROPIC_API_KEY=
GLM_MONITOR_ANTHROPIC_BASE_URL=https://api.anthropic.com
GLM_MONITOR_ANTHROPIC_POLL_INTERVAL_SECONDS=300
#
# Anthropic FORWARD-PROXY collector: captures Claude Code usage PER REQUEST by
# intercepting its own traffic to api.anthropic.com. Works with a Claude
# Pro/Max subscription (OAuth) too — usage is read from the streamed response.
# Point Claude Code at it:  set ANTHROPIC_BASE_URL=http://localhost:8090
GLM_MONITOR_ANTHROPIC_PROXY_ENABLED=false
GLM_MONITOR_ANTHROPIC_PROXY_PORT=8090
GLM_MONITOR_ANTHROPIC_PROXY_TARGET_URL=https://api.anthropic.com
GLM_MONITOR_ANTHROPIC_PROXY_APPLICATION=claude-code

# Server
GLM_MONITOR_HOST=0.0.0.0
GLM_MONITOR_PORT=8000
GLM_MONITOR_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Retention + logging
GLM_MONITOR_RETENTION_DAYS=90
GLM_MONITOR_LOG_LEVEL=INFO
GLM_MONITOR_LOG_FORMAT=console
